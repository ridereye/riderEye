<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <!-- LOGO HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="RIDER EYE PH"
            android:textColor="#1E90FF"
            android:textSize="28sp"
            android:textStyle="bold|italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="RESET PASSWORD"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verify your details to set a new password"
            android:textColor="#8A8A8E"
            android:textSize="12sp"
            android:layout_marginBottom="32dp" />

        <!-- USERNAME -->
        <EditText
            android:id="@+id/et_reset_username"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="14dp"
            android:background="#1E1E28"
            android:hint="Username"
            android:textColorHint="#6E6E7A"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:inputType="text" />

        <!-- EMAIL -->
        <EditText
            android:id="@+id/et_reset_email"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="14dp"
            android:background="#1E1E28"
            android:hint="Email Address"
            android:textColorHint="#6E6E7A"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:inputType="textEmailAddress" />

        <!-- NEW PASSWORD -->
        <EditText
            android:id="@+id/et_new_password"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="28dp"
            android:background="#1E1E28"
            android:hint="New Password"
            android:textColorHint="#6E6E7A"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:inputType="textPassword" />

        <!-- RESET BUTTON -->
        <Button
            android:id="@+id/btn_reset_password"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="UPDATE PASSWORD"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#990000" />

    </LinearLayout>
</ScrollView>