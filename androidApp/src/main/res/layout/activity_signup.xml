<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- LOGO HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="RIDER EYE PH"
            android:textColor="#1E90FF"
            android:textSize="26sp"
            android:textStyle="bold|italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="CREATE ACCOUNT"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign up to start protecting your rides"
            android:textColor="#8A8A8E"
            android:textSize="12sp"
            android:layout_marginBottom="24dp" />

        <!-- FIRST NAME -->
        <EditText
            android:id="@+id/et_fname"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="#1E1E28"
            android:hint="First Name"
            android:textColorHint="#6E6E7A"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:inputType="textPersonName" />

        <!-- MIDDLE NAME -->
        <EditText
            android:id="@+id/et_mname"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="#1E1E28"
            android:hint="Middle Name (Optional)"
            android:textColorHint="#6E6E7A"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:inputType="textPersonName" />

        <!-- LAST NAME -->
        <EditText
            android:id="@+id/et_lname"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="#1E1E28"
            android:hint="Last Name"
            android:textColorHint="#6E6E7A"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:inputType="textPersonName" />

        <!-- CONTACT NUMBER -->
        <EditText
            android:id="@+id/et_cnumber"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="#1E1E28"
            android:hint="Contact Number"
            android:textColorHint="#6E6E7A"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:inputType="phone" />

        <!-- EMAIL -->
        <EditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="#1E1E28"
            android:hint="Email Address"
            android:textColorHint="#6E6E7A"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:inputType="textEmailAddress" />

        <!-- USERNAME -->
        <EditText
            android:id="@+id/et_username"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="#1E1E28"
            android:hint="Username"
            android:textColorHint="#6E6E7A"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:inputType="text" />

        <!-- GENDER SPINNER LABEL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="Gender"
            android:textColor="#8A8A8E"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinner_gender"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="#1E1E28"
            android:paddingHorizontal="12dp" />

        <!-- USER TYPE SPINNER LABEL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="User Type"
            android:textColor="#8A8A8E"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinner_usertype"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="#1E1E28"
            android:paddingHorizontal="12dp" />

        <!-- PASSWORD -->
        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="#1E1E28"
            android:hint="Password"
            android:textColorHint="#6E6E7A"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:inputType="textPassword" />

        <!-- TERMS AND CONDITIONS CHECKBOX -->
        <CheckBox
            android:id="@+id/cb_terms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="I agree to the Terms and Conditions and Privacy Policy"
            android:textColor="#C7C7CC"
            android:textSize="13sp"
            android:buttonTint="#1E90FF" />

        <!-- REGISTER BUTTON -->
        <Button
            android:id="@+id/btn_signup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CREATE ACCOUNT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#990000"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>