<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="#121212">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RIDER EYE"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.05" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp"
        android:text="Dashboard"
        android:textSize="13sp"
        android:textColor="#8A8A99" />

    <!-- Status Pill -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="●  Ready to Ride"
        android:textColor="#4CAF50"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <!-- Center content: SOS + buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- SOS CIRCLE BUTTON -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSos"
            android:layout_width="140dp"
            android:layout_height="140dp"
            app:cardCornerRadius="70dp"
            app:cardBackgroundColor="#DC2626"
            app:strokeColor="#EF4444"
            app:strokeWidth="3dp"
            android:layout_marginBottom="28dp"
            android:elevation="10dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOS"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="EMERGENCY"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFD1D1"
                    android:letterSpacing="0.1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Start Ride Button -->
        <Button
            android:id="@+id/btnStartRide"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="START RIDE"
            android:background="@drawable/bg_button_primary"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:layout_marginBottom="12dp" />

        <!-- Share Link Button -->
        <Button
            android:id="@+id/btnShareLocation"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="SHARE LINK"
            android:background="@drawable/bg_button_secondary"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- Logout Button (bottom) -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="LOGOUT"
        android:background="@drawable/bg_button_ghost"
        android:textColor="#B0B0BC"
        android:textSize="13sp"
        android:letterSpacing="0.05"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

</LinearLayout>